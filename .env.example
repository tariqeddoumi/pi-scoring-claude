# === Base de données (Prisma / Supabase) ===
# Schéma applicatif = pi_scoring → AJOUTER ?schema=pi_scoring aux deux URLs.
# DATABASE_URL : pooler Supabase (port 6543) pour le serverless Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1&schema=pi_scoring"
# DIRECT_URL : connexion directe (port 5432), utilisée pour les migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=pi_scoring"

# === Authentification Supabase (exposées au client) ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# === Identité visuelle (paramétrable, optionnel) ===
# Nom complet (titre + page de connexion). Défaut : "Scoring des projets de promotion immobilière".
NEXT_PUBLIC_APP_NAME=
# Nom court (barre latérale). Défaut : même valeur que NEXT_PUBLIC_APP_NAME.
NEXT_PUBLIC_APP_NAME_SHORT=
# Sous-titre / slogan. Défaut : "BKAM 19/G · 1/W/2025".
NEXT_PUBLIC_APP_TAGLINE=
# Logo (chemin same-origin recommandé, ex. /logo.svg dans public/). Défaut : /logo.svg.
NEXT_PUBLIC_APP_LOGO_URL=

# === Optionnel : extraction IA des rapports de visite ===
# ANTHROPIC_API_KEY=

# === Scripts locaux uniquement (NE PAS mettre sur Vercel) ===
# SUPABASE_SERVICE_ROLE_KEY=   # provisioning des comptes Auth (secret)
# DEMO_USER_PASSWORD=          # mot de passe initial commun des comptes démo
